# LiveKit (set automatically when deployed to LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# xAI, for Grok realtime voice
XAI_API_KEY=your_xai_api_key

# Staycio platform. VOICE_AGENT_SECRET must match the Vercel env var of the same name.
STAYCIO_API_URL=https://staycio.com
VOICE_AGENT_SECRET=long_random_string

# Optional: Grok voice (ara, eve, luna, iris, celeste, ...). Default: ara
STACY_VOICE=ara
