# =================================
# Staycio Environment Variables
# =================================

# Supabase
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# xAI (Grok)
# Get your API key from https://x.ai
XAI_API_KEY=your-xai-api-key
XAI_BASE_URL=https://api.x.ai/v1

# xAI Collections (RAG - semantic search)
# Management key: https://x.ai (needs AddFileToCollection permission)
# Collection ID: set after running scripts/upload-to-collection.ts --create-collection
XAI_MANAGEMENT_API_KEY=your-management-api-key
XAI_COLLECTION_ID=your-collection-id

# Resend (Email)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your-resend-api-key
FROM_EMAIL="Staycio <hello@staycio.com>"
# OPTIONAL push copy of "new lead" alerts. Leave empty: every lead is already
# written straight into the admin inbox at /admin/email, which cannot bounce.
# Only set this to a mailbox that genuinely receives mail. Never FROM_EMAIL —
# staycio.com has no MX record, and addressing alerts to it lost 65 leads.
LEAD_NOTIFY_EMAIL=
# Reply-To on renter-facing mail. Defaults to replies@inbound.staycio.com so
# replies thread into the admin inbox; override once the apex has a mailbox.
REPLY_TO_EMAIL=
# Resend inbound webhook signing secret (Resend dashboard > Webhooks)
RESEND_WEBHOOK_SECRET=whsec_your-webhook-secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: LiveKit (for voice features)
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=

# Upstash Redis (distributed rate limiting; falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
